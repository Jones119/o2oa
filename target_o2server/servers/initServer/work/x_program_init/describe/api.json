          "method": "GET"
        },
        {
          "name": "detail",
          "uri": "jaxrs/cache/detail",
          "method": "GET"
        }
      ]
    },
    {
      "name": "EchoAction",
      "methods": [
        {
          "name": "get",
          "uri": "jaxrs/echo",
          "method": "GET"
        }
      ]
    },
    {
      "name": "ExternalDataSourcesAction",
      "methods": [
        {
          "name": "list",
          "uri": "jaxrs/externaldatasources/list",
          "method": "GET"
        },
        {
          "name": "validate",
          "uri": "jaxrs/externaldatasources/validate",
          "method": "POST",
          "enctype": "application/json"
        },
        {
          "name": "set",
          "uri": "jaxrs/externaldatasources/set",
          "method": "POST",
          "enctype": "application/json"
        },
        {
          "name": "check",
