          "method": "GET"
        }
      ]
    },
    {
      "name": "H2Action",
      "methods": [
        {
          "name": "check",
          "uri": "jaxrs/h2/check",
          "method": "GET"
        }
      ]
    },
    {
      "name": "RestoreAction",
      "methods": [
        {
          "name": "uploadCancel",
          "uri": "jaxrs/restore/upload/cancel",
