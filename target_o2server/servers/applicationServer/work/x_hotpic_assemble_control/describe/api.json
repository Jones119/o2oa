{
  "jaxrs": [
    {
      "name": "CacheAction",
      "methods": [
        {
          "name": "receive",
          "uri": "jaxrs/cache",
          "method": "POST",
          "enctype": "application/json"
        },
        {
          "name": "commonScriptFlush",
          "uri": "jaxrs/cache/commonscript/flush",
          "method": "GET"
        },
        {
          "name": "configFlush",
          "uri": "jaxrs/cache/config/flush",
          "method": "GET"
        },
        {
          "name": "detail",
          "uri": "jaxrs/cache/detail",
          "method": "GET"
        }
      ]
    },
    {
      "name": "EchoAction",
      "methods": [
        {
          "name": "get",
          "uri": "jaxrs/echo",
          "method": "GET"
        }
      ]
    },
    {
      "name": "FireScheduleAction",
      "methods": [
        {
          "name": "execute",
          "uri": "jaxrs/fireschedule/classname/{className}",
          "method": "GET"
        }
      ]
    },
    {
      "name": "HotPictureInfoAction",
      "methods": [
        {
          "name": "get",
          "uri": "jaxrs/user/hotpic/{id}",
          "method": "GET"
        },
        {
          "name": "save",
          "uri": "jaxrs/user/hotpic",
          "method": "POST",
          "enctype": "application/json"
        },
        {
          "name": "delete",
          "uri": "jaxrs/user/hotpic/{id}",
          "method": "DELETE",
          "enctype": "application/json"
        },
        {
          "name": "changeTitle",
          "uri": "jaxrs/user/hotpic/changeTitle",
          "method": "POST",
          "enctype": "application/json"
        },
        {
          "name": "deleteWithApplicationAndInfoId",
          "uri": "jaxrs/user/hotpic/{application}/{infoId}",
          "method": "DELETE",
          "enctype": "application/json"
        },
        {
          "name": "listForPage",
          "uri": "jaxrs/user/hotpic/filter/list/page/{page}/count/{count}",
          "method": "PUT",
          "enctype": "application/json"
        },
        {
          "name": "listByApplicationAndInfoId",
          "uri": "jaxrs/user/hotpic/{application}/{infoId}",
          "method": "GET"
        },
        {
          "name": "existsCheck",
          "uri": "jaxrs/user/hotpic/exists/check",
          "method": "GET"
        }
      ]
    },
    {
      "name": "HotPictureInfoCipherAction",
      "methods": [
        {
          "name": "get",
          "uri": "jaxrs/cipher/hotpic/{id}",
          "method": "GET"
        },
        {
          "name": "deleteCms",
          "uri": "jaxrs/cipher/hotpic/cms/{id}",
          "method": "DELETE",
          "enctype": "application/json"
        },
        {
          "name": "listForPage",
          "uri": "jaxrs/cipher/hotpic/filter/list/page/{page}/count/{count}",
          "method": "PUT",
          "enctype": "application/json"
        },
        {
          "name": "deleteBBS",
          "uri": "jaxrs/cipher/hotpic/bbs/{id}",
          "method": "DELETE",
          "enctype": "application/json"
        }
      ]
    }
  ]
}